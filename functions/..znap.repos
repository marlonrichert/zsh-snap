#!/bin/zsh

..znap.repos-dir

if (( $# > 1 )); then
  shift
  repos=( $gitdir/${^@}(ND-/) )
  repos=( ${repos[@]#$gitdir/} )
else
  repos=( $gitdir/*{,/*}/.git(ND-/:h) )
  repos=( ${repos[@]#$gitdir/} )

  local -a exclude=()
  if zstyle -a ":znap:$1:" exclude exclude; then
    repos=( ${repos[@]:#${(~j:|:)~exclude}} )
  fi
fi
